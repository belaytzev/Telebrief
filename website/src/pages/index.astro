---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import { Image } from 'astro:assets';
import logoImage from '../../public/logo.webp';

const repo = 'https://github.com/belaytzev/Telebrief';
const quickStart = `${repo}?tab=readme-ov-file#quick-start`;

const navLinks = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#features', label: 'Features' },
  { href: '#extend', label: 'Extend' },
];

const steps = [
  {
    title: 'Collect',
    text: 'Telebrief logs in to Telegram as you, through Telethon, and reads the last 24 hours of each channel. Private channels and groups you belong to work too.',
    chips: [{ label: 'telethon' }, { label: 'private channels' }, { label: 'per-channel window' }],
  },
  {
    title: 'Summarize',
    text: 'The AI provider you picked writes a short summary of each channel and, if you want, sorts messages into topics such as News or Events, in the language you chose.',
    chips: [{ label: 'OpenAI', accent: true }, { label: 'Anthropic', accent: true }, { label: 'Ollama', accent: true }],
  },
  {
    title: 'Deliver',
    text: 'Your own bot sends the digest with a link to each channel, on schedule or when you ask. AI agents can fetch the same digest over MCP.',
    chips: [{ label: 'scheduled' }, { label: 'on demand' }, { label: 'MCP' }],
  },
];

const commands = [
  { name: '/start', desc: 'Same as /help' },
  { name: '/digest', desc: 'Build a digest now, in the configured mode' },
  { name: '/cleanup', desc: 'Delete old digest messages from the chat' },
  { name: '/status', desc: 'AI provider and model, channel count, next run' },
  { name: '/help', desc: 'List the commands and how to use them' },
];

const featureGroups = [
  {
    title: 'Reading channels',
    items: [
      { name: 'Private channels', text: 'Telebrief reads as you, so any public or private channel or group you are in works.' },
      { name: 'Any input language', text: 'English, Russian, Ukrainian, Chinese and so on. The digest itself comes in English, Russian, Spanish, German or French.' },
      { name: 'Per-channel settings', text: 'Give each channel its own time window and extra AI instructions: a short window for a busy feed, a week for a newsletter.' },
    ],
  },
  {
    title: 'Writing the digest',
    items: [
      { name: 'Two digest modes', text: 'Group by channel, or by topics you name, such as News, Events or Sport. The AI puts each message under one of them.' },
      { name: 'Your choice of AI', text: 'OpenAI, Anthropic or a local Ollama model. Switching providers is one line in the config.' },
      { name: 'Long digests split', text: 'A digest over Telegram’s 4096-character limit arrives as several messages instead of being cut off.' },
    ],
  },
  {
    title: 'Delivery',
    items: [
      { name: 'Scheduled', text: 'Pick a time and the digest arrives every day. Ask the bot for one whenever you want it sooner.' },
      { name: 'Auto-cleanup', text: 'When a new digest arrives, the bot deletes the previous one from the chat.' },
      { name: 'MCP server', text: 'AI agents can fetch a fresh or cached digest, or one channel’s raw messages, over HTTP or stdio.' },
    ],
  },
  {
    title: 'Running it',
    items: [
      { name: 'Setup wizard', html: '<code>main.py init</code> logs in to Telegram, checks your bot, lets you pick channels and writes the config. No clone, no local Python.' },
      { name: 'Docker images', html: 'amd64 and arm64 images on GitHub Container Registry, tagged <code>latest</code>, <code>X.Y</code> and <code>X.Y.Z</code>.' },
      { name: 'Cheap to run', text: 'Free with a local Ollama model. With a cloud provider you pay only for tokens, with no subscription.' },
      { name: 'MIT license', text: 'Read it, fork it, extend it. Your messages stay on your own machine.' },
    ],
  },
];

const hooks = [
  { name: 'Filters', text: 'Drop noise before the AI sees it. Keyword, regex and length filters are built in, and each channel can have its own set.', sig: 'MessageFilter' },
  { name: 'Prompts', text: 'Replace the base template or plug in your own composer to set tone and focus per channel.', sig: 'PromptComposer' },
  { name: 'Group binding', text: 'Bind channels to a digest group. The group’s instructions go into the prompt before the channel’s own.', sig: 'digest_groups[].prompt_extra' },
  { name: 'Storage queries', text: 'Read stored messages from your own scripts, by channel and time range.', sig: 'backend.query_messages()' },
];
---

<Layout title="Telebrief: AI digest bot for Telegram">

  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <Image src={logoImage} alt="" class="nav-logo" width={28} height={28} loading="eager" />
        <span>telebrief</span>
      </a>

      <nav class="nav-desktop" aria-label="Main">
        {navLinks.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
        <a href={repo} class="btn btn-ghost nav-github" target="_blank" rel="noopener noreferrer">
          <GitHubIcon size={15} />
          GitHub
        </a>
      </nav>

      <details class="nav-mobile">
        <summary aria-label="Menu">
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav class="nav-sheet" aria-label="Main">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">

    <section class="section hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">AI digest bot for Telegram</h1>
          <p class="hero-lede">
            Telebrief reads the Telegram channels you pick, summarizes them
            with AI and sends you one digest a day through your own bot.
          </p>
          <div class="actions">
            <a href={quickStart} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Read the Quick Start</a>
            <a href={repo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              <GitHubIcon />
              View on GitHub
            </a>
          </div>
          <p class="hero-note">
            Self-hosted and MIT-licensed. Runs on OpenAI, Anthropic
            or a free local Ollama model.
          </p>
        </div>

        <div class="hero-demo">
          <fieldset class="segmented">
            <legend>Group the example digest</legend>
            <label><input type="radio" name="digest-mode" id="mode-channel" checked />By channel</label>
            <label><input type="radio" name="digest-mode" id="mode-topic" />By topic</label>
          </fieldset>

          <div class="chat digest">
            <div class="chat-head">
              <Image src={logoImage} alt="" class="chat-avatar" width={32} height={32} loading="eager" />
              <div>
                <p class="chat-name">Telebrief Bot</p>
                <p class="chat-meta">12:00</p>
              </div>
            </div>

            <div class="chat-body digest-channel">
              <p class="d-title">📊 Daily Digest - 02 May 2026</p>
              <p class="d-head">🎯 Brief Overview</p>
              <p>A busy day in tech: a major framework release and a security patch worth applying. Markets closed higher, and there is a self-hosting meetup this Friday.</p>
              <p class="d-head">💻 Tech News · <span class="d-link">Open channel →</span></p>
              <ul>
                <li>🚀 <strong>Framework 2.0 released</strong> — faster builds, new plugin API</li>
                <li>🔐 <strong>Security advisory</strong> — patch for a popular web server</li>
                <li>📱 <strong>Phone launch rumors</strong> — lighter frame, bigger battery</li>
              </ul>
              <p class="d-head">💰 Markets · <span class="d-link">Open channel →</span></p>
              <ul>
                <li>📈 <strong>Stocks close higher</strong> — tech shares lead the rally</li>
                <li>🏦 <strong>Rate decision</strong> — central bank holds steady</li>
              </ul>
              <p class="d-stats">📈 Statistics: 3 channels, 214 messages processed</p>
            </div>

            <div class="chat-body digest-topic">
              <p class="d-title">📊 Daily Digest - 02 May 2026</p>
              <p class="d-head">🎯 Brief Overview</p>
              <p>A busy day in tech: a major framework release and a security patch worth applying. Markets closed higher, and there is a self-hosting meetup this Friday.</p>
              <p class="d-head">📰 News</p>
              <ul>
                <li>🚀 <strong>Framework 2.0 released</strong> — faster builds, new plugin API <span class="d-link">(Tech News)</span></li>
                <li>📈 <strong>Stocks close higher</strong> — tech shares lead the rally <span class="d-link">(Markets)</span></li>
                <li>🔐 <strong>Security advisory</strong> — patch for a popular web server <span class="d-link">(Tech News, Sysadmin)</span></li>
              </ul>
              <p class="d-head">🎉 Events</p>
              <ul>
                <li>🎤 <strong>Self-hosting meetup on Friday</strong> — talks and demos <span class="d-link">(City Events)</span></li>
              </ul>
              <p class="d-stats">📈 Statistics: 4 channels, 268 messages processed</p>
            </div>
          </div>

          <p class="demo-caption">An example digest. You pick the grouping with <code>digest_mode</code> in <code>config.yaml</code>.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head">
          <h2 id="how-title">How it works</h2>
          <p>Every run goes through three steps, from raw channel messages to one message in your chat.</p>
        </div>

        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step">
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <div class="chip-row">
                {s.chips.map((c) => <span class:list={['chip', { 'chip-accent': c.accent }]}>{c.label}</span>)}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="commands" class="section" aria-labelledby="commands-title">
      <div class="container split">
        <div class="section-head">
          <h2 id="commands-title">Bot commands</h2>
          <p>You control Telebrief by messaging your bot. These are the commands in its menu.</p>
        </div>

        <div class="chat commands">
          <div class="chat-head">
            <Image src={logoImage} alt="" class="chat-avatar" width={32} height={32} loading="lazy" />
            <div>
              <p class="chat-name">Telebrief Bot</p>
              <p class="chat-meta">Menu</p>
            </div>
          </div>
          <dl class="cmd-list">
            {commands.map((c) => (
              <div class="cmd">
                <dt><code>{c.name}</code></dt>
                <dd>{c.desc}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section id="features" class="section" aria-labelledby="features-title">
      <div class="container">
        <div class="section-head">
          <h2 id="features-title">Features</h2>
          <p>Read one message a day instead of every channel.</p>
        </div>

        <div class="groups">
          {featureGroups.map((g) => (
            <div class="group">
              <h3 class="group-title">{g.title}</h3>
              <ul class="group-items">
                {g.items.map((f) => (
                  <li>
                    <h4>{f.name}</h4>
                    {f.html ? <p set:html={f.html} /> : <p>{f.text}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="extend" class="section" aria-labelledby="extend-title">
      <div class="container">
        <div class="section-head">
          <h2 id="extend-title">Storage and extensibility</h2>
          <p>Keep every collected message and adapt Telebrief to your setup from the config file, without changing its code.</p>
        </div>

        <div class="split extend-block">
          <div>
            <h3 class="sub-title">Persistent storage</h3>
            <p>Save every collected message to a database, to look back, search, or feed other tools. It is off by default.</p>
            <p>Both backends share one schema, and <code>query_messages()</code> reads it from your own scripts.</p>
            <a href={`${repo}?tab=readme-ov-file#persistent-storage`} class="text-link" target="_blank" rel="noopener noreferrer">Storage docs</a>
          </div>

          <div class="store">
            <fieldset class="segmented">
              <legend>Storage backend</legend>
              <label><input type="radio" name="store-backend" id="store-sqlite" checked />SQLite</label>
              <label><input type="radio" name="store-backend" id="store-postgres" />PostgreSQL</label>
            </fieldset>

            <div class="store-panel store-sqlite">
              <pre class="code-block"><code><span class="k">storage</span>:
  <span class="k">enabled</span>: true
  <span class="k">backend</span>: sqlite
  <span class="k">path</span>: data/messages.db</code></pre>
              <p class="store-note">The default. One file, no setup, survives restarts on a mounted volume.</p>
            </div>
            <div class="store-panel store-postgres">
              <pre class="code-block"><code><span class="k">storage</span>:
  <span class="k">enabled</span>: true
  <span class="k">backend</span>: postgres
  <span class="k">url</span>: "postgresql://user:pass@host:5432/dbname"</code></pre>
              <p class="store-note">For several hosts or concurrent readers. The <code>asyncpg</code> driver is already included.</p>
            </div>
          </div>
        </div>

        <div class="extend-block">
          <h3 class="sub-title">Extension points</h3>
          <ul class="hooks">
            {hooks.map((h) => (
              <li>
                <h4>{h.name}</h4>
                <p>{h.text}</p>
                <code>{h.sig}</code>
              </li>
            ))}
          </ul>

          <p class="config-caption">Filters, a group prompt, a template and a channel binding in one config:</p>
          <pre class="code-block"><code><span class="k">settings</span>:
  <span class="k">filters</span>:
    - <span class="k">class_path</span>: src.extensions.filters.KeywordFilter
      <span class="k">config</span>: {'{'} <span class="k">include</span>: ["job", "hiring"] {'}'}
  <span class="k">digest_groups</span>:
    - <span class="k">name</span>: "Jobs"
      <span class="k">prompt_extra</span>: "Extract role, company, link."

<span class="k">prompts</span>:
  <span class="k">base_template</span>: src/prompts/base_summary.txt

<span class="k">channels</span>:
  - <span class="k">id</span>: "@techleads_jobs"
    <span class="k">name</span>: "Tech Jobs"
    <span class="k">group</span>: Jobs
    <span class="k">prompt_extra</span>: "Senior+ only."</code></pre>
          <a href={`${repo}?tab=readme-ov-file#extensibility`} class="text-link" target="_blank" rel="noopener noreferrer">Extensibility docs</a>
        </div>
      </div>
    </section>

    <section class="section cta" aria-labelledby="cta-title">
      <div class="container">
        <div class="section-head">
          <h2 id="cta-title">Try it</h2>
          <p>The setup wizard asks for your Telegram login, bot token and channels, then writes the config for Docker Compose.</p>
        </div>
        <div class="actions">
          <a href={quickStart} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Read the Quick Start</a>
          <a href={repo} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            <GitHubIcon />
            View on GitHub
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <span class="nav-brand">
          <Image src={logoImage} alt="" class="nav-logo" width={24} height={24} loading="lazy" />
          <span>telebrief</span>
        </span>
        <nav class="footer-links" aria-label="Footer">
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={`${repo}#readme`} target="_blank" rel="noopener noreferrer">Docs</a>
          <a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">Issues</a>
          <a href={`${repo}/discussions`} target="_blank" rel="noopener noreferrer">Discussions</a>
          <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">License</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Telebrief. Open source under the MIT License.</span>
        <a href="https://claude.ai/claude-code" class="credit" target="_blank" rel="noopener noreferrer">Built with Claude Code</a>
      </div>
    </div>
  </footer>

  <script>
    const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu?.open) {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });
  </script>

</Layout>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    position: relative;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nav-logo { width: 28px; height: 28px; border-radius: var(--radius-s); }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--dur-hover) ease;
  }

  .nav-github { min-height: 36px; padding: 0 var(--space-4); }

  .nav-mobile { display: none; }

  .nav-mobile summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-2) * -1);
    cursor: pointer;
    border-radius: var(--radius-m);
    touch-action: manipulation;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background: var(--text);
  }
  .burger { position: relative; }
  .burger::before,
  .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -6px; }
  .burger::after { top: 6px; }
  .nav-mobile[open] .burger { background: transparent; }
  .nav-mobile[open] .burger::before { top: 0; transform: rotate(45deg); }
  .nav-mobile[open] .burger::after { top: 0; transform: rotate(-45deg); }

  .nav-sheet {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-2) 1.25rem var(--space-4);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .nav-sheet a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--text);
    font-weight: 500;
    border-bottom: 1px solid var(--line);
  }
  .nav-sheet a:last-child { border-bottom: none; }

  .hero { padding: clamp(3rem, 8vw, 6rem) 0 var(--section-y); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-8);
    align-items: center;
  }

  .hero-lede {
    font-size: var(--fs-lg);
    max-width: 30rem;
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-note {
    margin-top: var(--space-5);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    max-width: 30rem;
  }

  .hero-demo { min-width: 0; }
  .hero-demo .segmented { margin-bottom: var(--space-4); }

  .digest {
    border-top-color: var(--accent-line);
    box-shadow: var(--shadow-panel);
    animation: rise var(--dur-enter) var(--ease-out) 120ms both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .digest .chat-body {
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .digest .chat-body > * + * { margin-top: var(--space-2); }
  .digest .d-title {
    color: var(--text);
    font-weight: 700;
    font-size: var(--fs-base);
  }
  .digest .d-head {
    color: var(--text);
    font-weight: 600;
    margin-top: var(--space-4);
  }
  .digest ul { list-style: none; }
  .digest li + li { margin-top: var(--space-1); }
  .d-link { color: var(--accent); }
  .digest .d-stats {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  .digest-topic { display: none; }
  .hero-demo:has(#mode-topic:checked) .digest-topic { display: block; }
  .hero-demo:has(#mode-topic:checked) .digest-channel { display: none; }

  .demo-caption {
    margin-top: var(--space-4);
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .step {
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .step p { font-size: var(--fs-sm); flex: 1; }

  .step-num {
    font-size: var(--fs-xl);
    font-weight: 800;
    line-height: 1;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--space-8);
    align-items: start;
  }

  .commands { max-width: 36rem; width: 100%; }

  .cmd-list { padding: var(--space-2) 0; }

  .cmd {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-5);
  }
  .cmd + .cmd { border-top: 1px solid var(--line); }
  .cmd dd { font-size: var(--fs-sm); }

  .groups { border-bottom: 1px solid var(--line); }

  .group {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--line);
  }

  .group-title { font-size: var(--fs-base); color: var(--text-muted); font-weight: 600; }

  .group-items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-7);
  }

  .group-items h4,
  .hooks h4 {
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: var(--space-1);
